#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# --- Rider Group ---
# Fichiers d'environnement locaux : ne jamais committer d'identifiants.
/env/*.json
!/env/example.json
.env
.env.*
# Configurations Firebase / Apple propres à chaque environnement.
/android/app/google-services.json
/ios/Runner/GoogleService-Info.plist
# Clés de signature Android.
/android/key.properties
*.jks
*.keystore
# Supabase CLI (état local).
/supabase/.branches/
/supabase/.temp/

# --- Kin Guide ---
# Node (back-office web, outils).
node_modules/
dist/
.next/
npm-debug.log*
yarn-error.log*
.pnpm-store/
# Variables d'environnement, où qu'elles se trouvent (les modèles restent suivis).
**/.env
**/.env.*
!**/.env.example
# Supabase CLI, où que soit le dossier supabase/.
**/supabase/.branches/
**/supabase/.temp/
**/supabase/.env
# Clés et certificats.
*.pem
*.key
*.p12
*.p8
*.mobileprovision
service-account*.json
# Signature Android, où que soit le dossier android/.
**/key.properties
**/local.properties
